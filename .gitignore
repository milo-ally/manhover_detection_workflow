# Keep placeholder files
!**/.gitkeep

# Keep reproducible workflow source/config/docs
!model_train/*.py
!model_train/*.txt
!model_export/*.py
!model_convert/*.py
!model_convert/*.md
!model_convert/*.txt
!model_convert/requirements.txt
